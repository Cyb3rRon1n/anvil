services:
{% if 'ollama' in enabled %}
  ollama:
    image: {% if gpu_vendor == 'amd' %}ollama/ollama:rocm{% else %}ollama/ollama:latest{% endif %}

    container_name: ollama
    volumes:
      - ./data/ollama:/root/.ollama
    ports:
      - "11434:11434"
{% if gpu_vendor == 'nvidia' %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
{% elif gpu_vendor == 'amd' %}
    devices:
      - /dev/kfd
      - /dev/dri
{% if render_gid %}
    group_add:
      - "{{ render_gid }}"
{% endif %}
{% endif %}
    restart: unless-stopped
{% endif %}
{% if 'open-webui' in enabled %}
  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: open-webui
    environment:
      - OLLAMA_BASE_URL=http://ollama:11434
    volumes:
      - ./data/open-webui:/app/backend/data
    ports:
      - "3000:8080"
    depends_on:
      - ollama
    restart: unless-stopped
{% endif %}
{% if 'comfyui' in enabled and gpu_vendor == 'nvidia' %}
  comfyui:
    image: mmartial/comfyui-nvidia-docker:latest
    container_name: comfyui
    environment:
      - WANTED_UID={{ puid }}
      - WANTED_GID={{ pgid }}
      - BASE_DIRECTORY=/basedir
      - SECURITY_LEVEL=normal
    volumes:
      - ./data/comfyui/run:/comfy/mnt
      - ./data/comfyui/basedir:/basedir
    ports:
      - "8188:8188"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    restart: unless-stopped
{% elif 'comfyui' in enabled and gpu_vendor == 'amd' %}
  comfyui:
    image: corundex/comfyui-rocm:latest
    container_name: comfyui
    devices:
      - /dev/kfd
      - /dev/dri
{% if render_gid %}
    group_add:
      - "{{ render_gid }}"
{% endif %}
    volumes:
      - ./data/comfyui/models:/workspace/ComfyUI/models
      - ./data/comfyui/output:/workspace/ComfyUI/output
      - ./data/comfyui/input:/workspace/ComfyUI/input
      - ./data/comfyui/custom_nodes:/workspace/ComfyUI/custom_nodes
      - ./data/comfyui/user:/workspace/ComfyUI/user
    ports:
      - "8188:8188"
    restart: unless-stopped
{% elif 'comfyui' in enabled and gpu_vendor == 'intel' %}
  comfyui:
    image: yanwk/comfyui-boot:xpu
    container_name: comfyui
    devices:
      - /dev/dri
    ipc: host
    security_opt:
      - label=disable
    volumes:
      - ./data/comfyui/models:/root/ComfyUI/models
      - ./data/comfyui/input:/root/ComfyUI/input
      - ./data/comfyui/output:/root/ComfyUI/output
      - ./data/comfyui/user:/root/ComfyUI/user
    ports:
      - "8188:8188"
    restart: unless-stopped
{% endif %}
{% if 'invokeai' in enabled and gpu_vendor == 'nvidia' %}
  invokeai:
    image: ghcr.io/invoke-ai/invokeai:latest
    container_name: invokeai
    environment:
      - INVOKEAI_ROOT=/invokeai
      - CONTAINER_UID={{ puid }}
    volumes:
      - ./data/invokeai:/invokeai
    ports:
      - "9090:9090"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    restart: unless-stopped
{% elif 'invokeai' in enabled and gpu_vendor == 'amd' %}
  invokeai:
    image: ghcr.io/invoke-ai/invokeai:main-rocm
    container_name: invokeai
    runtime: amd
    environment:
      - INVOKEAI_ROOT=/invokeai
      - CONTAINER_UID={{ puid }}
      - AMD_VISIBLE_DEVICES=all
{% if render_gid %}
      - RENDER_GROUP_ID={{ render_gid }}
{% endif %}
    volumes:
      - ./data/invokeai:/invokeai
    ports:
      - "9090:9090"
    restart: unless-stopped
{% endif %}
  dashboard:
    image: nginx:alpine
    container_name: dashboard
    volumes:
      - ./dashboard:/usr/share/nginx/html:ro
    ports:
      - "8080:80"
    restart: unless-stopped
