services:
{% if 'ollama' in enabled %}
  ollama:
    image: {% if gpu_vendor == 'amd' %}ollama/ollama:rocm{% else %}ollama/ollama:latest{% endif %}

    container_name: ollama
    volumes:
      - ./data/ollama:/root/.ollama
    ports:
      - "{{ ports.ollama }}:11434"
{% if gpu_vendor == 'nvidia' %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
{% elif gpu_vendor == 'amd' %}
    devices:
      - /dev/kfd
      - /dev/dri
{% if render_gid %}
    group_add:
      - "{{ render_gid }}"
{% endif %}
{% endif %}
    restart: unless-stopped
{% endif %}
{% if 'open-webui' in enabled %}
  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: open-webui
    environment:
      - OLLAMA_BASE_URL=http://ollama:11434
    volumes:
      - ./data/open-webui:/app/backend/data
    ports:
      - "{{ ports['open-webui'] }}:8080"
    depends_on:
      - ollama
    restart: unless-stopped
{% endif %}
{% if 'comfyui' in enabled and gpu_vendor == 'nvidia' %}
  comfyui:
    image: mmartial/comfyui-nvidia-docker:latest
    container_name: comfyui
    environment:
      - WANTED_UID={{ puid }}
      - WANTED_GID={{ pgid }}
      - BASE_DIRECTORY=/basedir
      - SECURITY_LEVEL=normal
    volumes:
      - ./data/comfyui/run:/comfy/mnt
      - ./data/comfyui/basedir:/basedir
    ports:
      - "{{ ports.comfyui }}:8188"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    restart: unless-stopped
{% elif 'comfyui' in enabled and gpu_vendor == 'amd' %}
  comfyui:
    image: corundex/comfyui-rocm:latest
    container_name: comfyui
    devices:
      - /dev/kfd
      - /dev/dri
{% if render_gid %}
    group_add:
      - "{{ render_gid }}"
{% endif %}
    volumes:
      - ./data/comfyui/models:/workspace/ComfyUI/models
      - ./data/comfyui/output:/workspace/ComfyUI/output
      - ./data/comfyui/input:/workspace/ComfyUI/input
      - ./data/comfyui/custom_nodes:/workspace/ComfyUI/custom_nodes
      - ./data/comfyui/user:/workspace/ComfyUI/user
    ports:
      - "{{ ports.comfyui }}:8188"
    restart: unless-stopped
{% elif 'comfyui' in enabled and gpu_vendor == 'intel' %}
  comfyui:
    image: yanwk/comfyui-boot:xpu
    container_name: comfyui
    devices:
      - /dev/dri
    ipc: host
    security_opt:
      - label=disable
    volumes:
      - ./data/comfyui/models:/root/ComfyUI/models
      - ./data/comfyui/input:/root/ComfyUI/input
      - ./data/comfyui/output:/root/ComfyUI/output
      - ./data/comfyui/user:/root/ComfyUI/user
    ports:
      - "{{ ports.comfyui }}:8188"
    restart: unless-stopped
{% endif %}
{% if 'invokeai' in enabled and gpu_vendor == 'nvidia' %}
  invokeai:
    image: ghcr.io/invoke-ai/invokeai:latest
    container_name: invokeai
    environment:
      - INVOKEAI_ROOT=/invokeai
      - CONTAINER_UID={{ puid }}
    volumes:
      - ./data/invokeai:/invokeai
    ports:
      - "{{ ports.invokeai }}:9090"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    restart: unless-stopped
{% elif 'invokeai' in enabled and gpu_vendor == 'amd' %}
  invokeai:
    image: ghcr.io/invoke-ai/invokeai:main-rocm
    container_name: invokeai
    runtime: amd
    environment:
      - INVOKEAI_ROOT=/invokeai
      - CONTAINER_UID={{ puid }}
      - AMD_VISIBLE_DEVICES=all
{% if render_gid %}
      - RENDER_GROUP_ID={{ render_gid }}
{% endif %}
    volumes:
      - ./data/invokeai:/invokeai
    ports:
      - "{{ ports.invokeai }}:9090"
    restart: unless-stopped
{% endif %}
{% if 'qdrant' in enabled %}
  qdrant:
    image: qdrant/qdrant:v1.16.3
    container_name: qdrant
    volumes:
      - ./data/qdrant:/qdrant/storage
    ports:
      - "{{ ports.qdrant }}:6333"
    restart: unless-stopped
{% endif %}
{% if 'embeddings' in enabled %}
  embeddings:
    image: ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.1
    platform: linux/amd64
    container_name: embeddings
    environment:
      - MODEL_ID=BAAI/bge-base-en-v1.5
    volumes:
      - ./data/embeddings:/data
    ports:
      - "{{ ports.embeddings }}:80"
    restart: unless-stopped
{% endif %}
{% if 'whisper' in enabled %}
  whisper:
    image: ghcr.io/speaches-ai/speaches:0.9.0-rc.3-cpu
    container_name: whisper
    volumes:
      - ./data/whisper:/home/ubuntu/.cache/huggingface/hub
    ports:
      - "{{ ports.whisper }}:8000"
    restart: unless-stopped
{% endif %}
{% if 'tts' in enabled %}
  tts:
    image: ghcr.io/remsky/kokoro-fastapi-cpu:v0.2.4
    container_name: tts
    environment:
      - DEFAULT_VOICE=af_heart
    ports:
      - "{{ ports.tts }}:8880"
    restart: unless-stopped
{% endif %}
{% if 'n8n' in enabled %}
  n8n:
    image: n8nio/n8n:2.6.4
    container_name: n8n
    user: "{{ puid }}:{{ pgid }}"
    environment:
      - N8N_HOST=localhost
      - N8N_PORT=5678
      - N8N_PROTOCOL=http
      - WEBHOOK_URL=http://localhost:{{ ports.n8n }}
      - GENERIC_TIMEZONE=UTC
    volumes:
      - ./data/n8n:/home/node/.n8n
    ports:
      - "{{ ports.n8n }}:5678"
    restart: unless-stopped
{% endif %}
{% if 'litellm' in enabled %}
  litellm:
    image: ghcr.io/berriai/litellm:v1.81.3-stable
    container_name: litellm
    volumes:
      - ./config/litellm/config.yaml:/app/config.yaml:ro
    ports:
      - "{{ ports.litellm }}:4000"
    command: ["--config", "/app/config.yaml", "--port", "4000"]
    restart: unless-stopped
{% endif %}
{% if 'searxng' in enabled %}
  searxng:
    image: searxng/searxng:2026.3.8-a563127a2
    container_name: searxng
    environment:
      - SEARXNG_BASE_URL=http://localhost:{{ ports.searxng }}/
      - SEARXNG_SECRET={{ searxng_secret }}
    volumes:
      - ./data/searxng:/etc/searxng
    ports:
      - "{{ ports.searxng }}:8080"
    restart: unless-stopped
{% endif %}
{% if 'vane' in enabled %}
  vane:
    image: itzcrazykns1337/vane:slim-latest
    container_name: vane
    environment:
      - SEARXNG_API_URL=http://searxng:8080
    volumes:
      - ./data/vane:/home/vane/data
    ports:
      - "{{ ports.vane }}:3000"
    restart: unless-stopped
{% endif %}
{% if 'localai' in enabled %}
  localai:
    image: quay.io/go-skynet/local-ai:v4.8.2
    container_name: localai
    environment:
      - MODELS_PATH=/models
      - LOCALAI_VRAM_WARM_LIMIT=0
    volumes:
      - ./data/localai/models:/models
      - ./data/localai/data:/data
    ports:
      - "{{ ports.localai }}:8080"
    restart: unless-stopped
{% endif %}
  dashboard:
    image: nginx:alpine
    container_name: dashboard
    volumes:
      - ./dashboard:/usr/share/nginx/html:ro
    ports:
      - "{{ ports.dashboard }}:80"
    restart: unless-stopped
