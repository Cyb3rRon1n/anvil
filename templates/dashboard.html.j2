<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Anvil</title>
<style>
  :root { color-scheme: dark; }
  body {
    font-family: system-ui, sans-serif;
    background: #111318;
    color: #e6e6e6;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    margin: 0;
  }
  main { max-width: 480px; width: 90%; padding: 2rem 0; }
  h1 { margin-bottom: 0.1rem; }
  p.sub { color: #8a8f98; margin-top: 0; }
  ul { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  li { margin: 0.75rem 0; }
  a {
    display: block;
    padding: 1rem 1.25rem;
    background: #1a1d24;
    border: 1px solid #2a2e37;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
  }
  a:hover { border-color: #4a90d9; }
  .name { font-weight: 600; font-size: 1.05rem; }
  .desc { color: #8a8f98; font-size: 0.85rem; margin-top: 0.15rem; }
</style>
</head>
<body>
<main>
  <h1>Anvil</h1>
  <p class="sub">Your local AI/creative stack</p>
  <ul>
{% if 'open-webui' in enabled %}
    <li>
      <a href="http://{{ host }}:3000">
        <div class="name">Open WebUI</div>
        <div class="desc">Chat with your local models</div>
      </a>
    </li>
{% endif %}
{% if 'comfyui' in enabled %}
    <li>
      <a href="http://{{ host }}:8188">
        <div class="name">ComfyUI</div>
        <div class="desc">Image generation</div>
      </a>
    </li>
{% endif %}
{% if 'invokeai' in enabled %}
    <li>
      <a href="http://{{ host }}:9090">
        <div class="name">InvokeAI</div>
        <div class="desc">Turnkey image generation</div>
      </a>
    </li>
{% endif %}
{% if 'ollama' in enabled %}
    <li>
      <a href="http://{{ host }}:11434">
        <div class="name">Ollama API</div>
        <div class="desc">Raw API, no interface - open this to confirm it's up</div>
      </a>
    </li>
{% endif %}
  </ul>
</main>
</body>
</html>
